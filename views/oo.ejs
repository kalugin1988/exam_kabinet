<%- include('partials/header', {pageTitle:'Учреждения',activePage:'institutions'}) %>
<section class="page-heading"><div><p class="eyebrow">Справочник</p><h1>Образовательные учреждения</h1><p class="lead">Сведения об учреждениях используются при формировании экзаменационных документов.</p></div><button class="btn btn-primary" id="addInstitution" type="button">Добавить учреждение +</button></section>
<section aria-labelledby="institutionsTitle"><div class="section-heading"><h2 id="institutionsTitle">Список учреждений</h2><span class="badge" id="institutionCount">—</span></div><div id="ooList" class="record-grid" aria-live="polite"><p class="muted">Загрузка учреждений…</p></div></section>
<dialog id="ooModal" class="app-dialog"><form id="ooForm"><div class="dialog-heading"><h2 id="modalTitle">Добавить учреждение</h2><button class="icon-button" type="button" data-close-dialog aria-label="Закрыть">×</button></div><input type="hidden" id="recordId"><div class="form-grid"><div class="form-field"><label for="codeOmsu">Код ОМСУ</label><input id="codeOmsu" maxlength="100"></div><div class="form-field"><label for="codeOo">Код ОО</label><input id="codeOo" maxlength="100"></div><div class="form-field"><label for="numberOo">Номер ОО</label><input id="numberOo" maxlength="100"></div><div class="form-field"><label for="nameOo">Краткое название</label><input id="nameOo" maxlength="500"></div></div><div class="form-field"><label for="fullName">Полное наименование <span class="required">*</span></label><textarea id="fullName" rows="3" required maxlength="2000"></textarea></div><div id="institutionError" class="notice notice-error" role="alert" hidden></div><div class="dialog-actions"><button class="btn btn-secondary" type="button" data-close-dialog>Отмена</button><button class="btn btn-primary" type="submit">Сохранить</button></div></form></dialog>
<%- include('partials/footer', {scripts:['/assets/institutions.js']}) %>
