<%- include('partials/header', {pageTitle: 'Печать Р и М', activePage: 'forms'}) %>
<link rel="stylesheet" href="/assets/print.css">
<div class="page-heading">
  <div><p class="eyebrow">Документы · Формы Р и М</p><h1>Регистрация и мониторинг</h1><p class="lead">Подготовьте списки участников по кабинетам или школам. В каждом комплекте — листы по 25 участников и опись.</p></div>
  <a class="btn btn-secondary" href="/forms">Все документы</a>
</div>

<section class="panel print-settings" aria-labelledby="printSettingsHeading">
  <div class="section-heading"><h2 id="printSettingsHeading">Параметры комплекта</h2><span class="badge">Р / М</span></div>
  <form id="printSettingsForm">
    <div class="form-grid">
      <div class="form-field"><label for="printGrouping">Группировать участников</label><select id="printGrouping"><option value="classroom">По кабинетам</option><option value="school">По школам</option></select></div>
      <div class="form-field"><label for="printSelection" id="printSelectionLabel">Кабинет</label><select id="printSelection" disabled><option value="">Загрузка кабинетов…</option></select><small class="form-help" id="printSelectionHelp">В списке показаны только группы с участниками.</small></div>
    </div>
    <fieldset class="print-format-options"><legend>Форма документа</legend>
      <label class="print-format-card"><input type="radio" name="printFormat" value="R" checked><span><strong>Форма Р</strong><small>Регистрация участников с колонкой для подписи</small></span></label>
      <label class="print-format-card"><input type="radio" name="printFormat" value="M"><span><strong>Форма М</strong><small>Мониторинг рассадки с названиями школ и примечаниями</small></span></label>
    </fieldset>
    <label class="checkbox-label"><input type="checkbox" id="printParallel" checked>Отдельные листы для каждой параллели</label>
    <div id="printMessage" class="notice" role="status" aria-live="polite" hidden></div>
    <div class="print-action-groups">
      <div class="button-row"><button class="btn btn-primary" id="printPreviewButton" type="submit" disabled>Предпросмотр</button><button class="btn btn-secondary" id="printSelectedButton" type="button" disabled>Печать выбранного</button><button class="btn btn-secondary" id="printExcelButton" type="button" disabled>Excel выбранного</button></div>
      <div class="button-row"><button class="btn btn-secondary" id="printAllButton" type="button" disabled>Печать всех кабинетов</button><button class="btn btn-quiet" id="printAllExcelButton" type="button" disabled>Excel всех кабинетов</button></div>
    </div>
    <p class="form-help print-action-help">«Все» создаёт отдельный комплект для каждого кабинета или школы. Для печати разрешите открытие нового окна в браузере.</p>
  </form>
</section>

<section class="print-preview-section" aria-labelledby="printPreviewHeading">
  <div class="section-heading"><h2 id="printPreviewHeading">Предпросмотр</h2><span class="muted" id="printPreviewStatus" aria-live="polite">Параметры ещё не выбраны</span></div>
  <div class="print-summary" id="printSummary" hidden aria-label="Статистика документов"></div>
  <div id="printPreview" class="print-preview"><div class="empty-state"><h3>Подготовьте комплект</h3><p>Выберите кабинет или школу, затем нажмите «Предпросмотр».</p></div></div>
</section>
<%- include('partials/footer', {scripts: ['/assets/vendor/xlsx.js', '/assets/print.js']}) %>
