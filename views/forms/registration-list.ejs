<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Лист регистрации участников</title>
    <style>
        body {
            font-family: 'Times New Roman', serif;
            margin: 0;
            padding: 20px;
        }
        .registration-list {
            max-width: 800px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .school-name {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 10px;
            text-transform: uppercase;
        }
        .olympiad-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 20px;
            text-transform: uppercase;
        }
        .document-title {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 20px;
            text-transform: uppercase;
        }
        .classroom-info {
            text-align: center;
            margin-bottom: 20px;
            font-size: 14px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            margin-bottom: 30px;
        }
        th, td {
            border: 1px solid black;
            padding: 5px;
            text-align: center;
            vertical-align: middle;
        }
        th {
            font-weight: bold;
            background-color: #f0f0f0;
        }
        .number-col {
            width: 5%;
        }
        .school-col {
            width: 15%;
        }
        .class-col {
            width: 10%;
        }
        .name-col {
            width: 30%;
            text-align: left;
        }
        .classroom-col {
            width: 10%;
        }
        .place-col {
            width: 10%;
        }
        .signature-col {
            width: 20%;
        }
        .print-button {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .print-button:hover {
            background-color: #0056b3;
        }
        @media print {
            .print-button {
                display: none;
            }
            body {
                padding: 0;
            }
        }

        .print-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            max-width: 800px;
            margin: 0 auto 24px;
            font-family: system-ui, sans-serif;
        }
        .print-toolbar a { color: #2757a5; text-decoration: none; }
        .print-toolbar .print-button { position: static; font: inherit; }
        .print-toolbar a, .print-button { transition: background-color 180ms ease, color 180ms ease; }
        .print-toolbar a:hover { text-decoration: underline; }
        .print-toolbar a:focus-visible, .print-button:focus-visible { outline: 3px solid #739cf2; outline-offset: 4px; }
        .print-button:active { transform: translateY(1px); }
        .print-page-footer { max-width: 800px; margin: 24px auto 0; color: #64748b; font: 12px system-ui, sans-serif; }
        @media screen and (max-width: 700px) {
            body { padding: 12px; }
            main { overflow-x: auto; }
            .statement, .registration-list, .sheet { min-width: 660px; }
            .print-toolbar { align-items: flex-start; }
        }
        @media print {
            .print-toolbar, .print-page-footer { display: none; }
            table { break-inside: auto; }
            tr { break-inside: avoid; }
            thead { display: table-header-group; }
        }
    </style>
</head>
<body>
    <header class="print-toolbar">
        <nav aria-label="Навигация печатных форм"><a href="/forms">← К печатным формам</a></nav>
    <button class="print-button" type="button" onclick="window.print()">Печать</button>
    </header>
    <main>
    
    <section class="registration-list">
        <header class="header">
            <div class="school-name">
                <%= school_name %>
            </div>
            <div class="olympiad-title">
                Олимпиада по "<%= subject %>". Муниципальный тур
            </div>
            <div class="document-title">
                ЛИСТ РЕГИСТРАЦИИ УЧАСТНИКОВ
            </div>
            <div class="classroom-info">
                Кабинет № <strong><%= classroom %></strong>
            </div>
        </header>

        <table>
            <thead>
                <tr>
                    <th class="number-col">№ п/п</th>
                    <th class="school-col">ОО</th>
                    <th class="class-col">Класс</th>
                    <th class="name-col">ФИО участника</th>
                    <th class="classroom-col">Ауд.</th>
                    <th class="place-col">Место</th>
                    <th class="signature-col">Подпись</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach((student, index) => { %>
                <tr>
                    <td><%= student.number %></td>
                    <td><%= student.school %></td>
                    <td><%= student.class %></td>
                    <td class="name-col"><%= student.fullName %></td>
                    <td><%= student.classroom %></td>
                    <td><%= student.workplace %></td>
                    <td><%= student.signature %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </section>
    </main>
    <footer class="print-page-footer">Документ подготовлен в системе организации олимпиад</footer>
</body>
</html>