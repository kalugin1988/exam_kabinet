<%- include('../partials/header', {pageTitle:'Документы',activePage:'forms'}) %>
<section class="page-heading"><div><p class="eyebrow">Оформление экзамена</p><h1>Документы и печать</h1><p class="lead">Выберите форму и параметры экзамена. Готовый документ откроется в отдельной вкладке для проверки и печати.</p></div><a class="btn btn-secondary" href="/print">Формы Р и М →</a></section>
<form id="documentForm" action="/forms/generate" method="get" target="_blank" rel="noopener"><section aria-labelledby="documentTypeTitle"><h2 id="documentTypeTitle">Что сформировать</h2><div class="document-grid">
<label class="document-card"><span><input type="radio" name="document_type" value="generate" checked> Ведомость аудитории</span><h3>Экзаменационная ведомость</h3><p>Участники, назначенные в выбранный кабинет или все кабинеты.</p></label>
<label class="document-card"><span><input type="radio" name="document_type" value="general-statement"> Сводная ведомость</span><h3>Общая ведомость</h3><p>Сводные сведения по предмету для всей экзаменационной площадки.</p></label>
<label class="document-card"><span><input type="radio" name="document_type" value="transfer-act"> Акт</span><h3>Акт приёма и передачи</h3><p>Передача экзаменационных материалов по выбранному предмету.</p></label>
<label class="document-card"><span><input type="radio" name="document_type" value="accompanying-sheet"> Сопроводительный лист</span><h3>Сопроводительные листы</h3><p>Сведения для передачи материалов по аудиториям и параллелям.</p></label>
<label class="document-card"><span><input type="radio" name="document_type" value="registration-list"> Регистрация</span><h3>Список регистрации</h3><p>Список участников с местами и полями для подписей.</p></label>
</div></section><section class="panel" aria-labelledby="documentParameters"><h2 id="documentParameters">Параметры экзамена</h2><div class="form-grid"><div class="form-field"><label for="documentSubject">Предмет</label><select id="documentSubject" name="subject" required><option value="">Выберите предмет</option><% subjects.forEach(item => { const subject = typeof item === 'string' ? item : item.предмет || item.subject; %><option value="<%= subject %>"><%= subject %></option><% }); %></select></div><div class="form-field"><label for="examDate">Дата экзамена</label><input id="examDate" name="exam_date" type="date" required></div><div class="form-field"><label for="siteCode">Код площадки</label><input id="siteCode" name="site_code" required maxlength="50" placeholder="Введите код площадки"></div><div class="form-field"><label for="schoolName">Название площадки <span class="muted">(необязательно)</span></label><input id="schoolName" name="school_name" maxlength="500" placeholder="Название образовательного учреждения"></div></div><div id="classroomFields"><label class="checkbox-label"><input id="allClassrooms" name="all_classrooms" type="checkbox" value="true">Сформировать для всех кабинетов</label><div class="form-field"><label for="documentClassroom">Кабинет</label><select id="documentClassroom" name="classroom" required><option value="">Выберите кабинет</option><% classrooms.forEach(room => { %><option value="<%= room.номер_кабинета %>">Кабинет №<%= room.номер_кабинета %></option><% }); %></select></div></div><div id="documentError" class="notice notice-error" role="alert" hidden></div><div class="button-row"><button type="submit" class="btn btn-primary">Открыть документ →</button><span class="form-help">Проверьте параметры перед печатью.</span></div></section></form>
<%- include('../partials/footer', {scripts:['/assets/forms.js']}) %>
