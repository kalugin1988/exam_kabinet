<%- include('partials/header', {pageTitle:'Рассадка',activePage:'seating'}) %>
<section class="page-heading"><div><p class="eyebrow">Распределение участников</p><h1>Рассадка по кабинетам</h1><p class="lead">Сформируйте рассадку по предмету или выберите место для ручной корректировки.</p></div><a class="btn btn-secondary" href="/forms">Перейти к документам →</a></section>
<section class="panel seating-toolbar" aria-label="Управление рассадкой"><form id="seatingForm"><div class="form-grid"><div class="form-field"><label for="subjectSelect">Предмет экзамена</label><select id="subjectSelect" required><option value="">Выберите предмет</option><% subjects.forEach(item => { const subject = typeof item === 'string' ? item : item.subject || item.предмет; %><option value="<%= subject %>"><%= subject %></option><% }); %></select></div><div class="form-field"><label>&nbsp;</label><div class="button-row"><button class="btn btn-primary" id="generateButton" type="submit">Сформировать рассадку</button><button class="btn btn-secondary" id="clearSeating" type="button">Снять с мест</button></div></div></div></form><div class="button-row"><button class="btn btn-quiet btn-sm" id="exportSeating" type="button">Экспорт JSON ↓</button><label class="btn btn-quiet btn-sm" for="importFile">Импорт JSON ↑</label><input id="importFile" type="file" accept="application/json,.json" hidden><button class="btn btn-danger btn-sm" id="clearStudents" type="button">Удалить участников</button></div><div class="seating-summary"><span>Всего: <strong id="totalStudents">—</strong></span><span>На местах: <strong id="placedStudents">—</strong></span><span>Без места: <strong id="unplacedStudents">—</strong></span><span class="legend">Занято</span><span class="legend free">Свободно</span><span class="legend blocked">Заблокировано</span></div></section>
<section aria-label="Схемы кабинетов"><p class="form-help">Выберите место, чтобы назначить или переместить участника. На компьютере участника можно перетащить на свободное место.</p><div id="classroomsContainer" class="classrooms-container"></div></section>
<dialog id="seatDialog" class="app-dialog"><div class="dialog-heading"><h2 id="seatDialogTitle">Место участника</h2><button type="button" class="icon-button" data-close-dialog aria-label="Закрыть">×</button></div><div id="seatDialogError" class="notice notice-error" role="alert" hidden></div><div id="seatDialogContent"></div></dialog>
<script id="seatingData" type="application/json"><%- JSON.stringify({classrooms,students,parallelColors}).replace(/</g, String.fromCharCode(92) + 'u003c') %></script>
<%- include('partials/footer', {scripts:['/assets/script.js']}) %>
