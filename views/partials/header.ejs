<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Экзамен' %> · Экзамен</title><link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержимому</a>
  <header class="app-header"><div class="header-inner">
    <a class="brand" href="/" aria-label="Экзамен — главная"><span class="brand-mark" aria-hidden="true">Э</span><span>Экзамен<small>Проведение и организация</small></span></a>
    <div class="account"><span class="account-label">Администратор</span><button class="btn btn-quiet btn-sm" type="button" id="logoutButton">Выйти</button></div>
  </div><nav class="main-nav" aria-label="Основная навигация">
    <% const links = [['dashboard','/','Обзор'],['import','/import','Импорт данных'],['seating','/seating','Рассадка'],['classrooms','/kabinet','Кабинеты'],['institutions','/oo','Учреждения'],['forms','/forms','Документы']]; %>
    <% links.forEach(([key,href,label]) => { %><a href="<%= href %>" <%- typeof activePage !== 'undefined' && activePage === key ? 'class="active" aria-current="page"' : '' %>><%= label %></a><% }); %>
  </nav></header>
  <main id="main" class="app-main" tabindex="-1"><div id="globalMessage" class="notice" role="status" aria-live="polite" hidden></div>
