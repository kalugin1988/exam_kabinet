# Node.js 24+. Запуск приложения: npm start
PORT=3000
# Необязательные значения: отсутствующая запись создаётся в SQLite.
# Установите свои значения перед запуском, чтобы задать администратора.
# ADMIN_LOGIN=
# ADMIN_PASSWORD= (не менее 12 символов)
# JWT_SECRET= (не менее 32 случайных байт)
# При каждом запуске заданные значения синхронизируются с SQLite.
# Изменение учётных данных завершает ранее выданные сессии.
# COOKIE_SECURE=true (включать при доступе через HTTPS)
